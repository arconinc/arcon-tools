  {
    "version": "0.1.0",
    "date": "2026-03-30",
    "title": "Initial Launch",
    "summary": "First release of The Arc — Arcon's internal tools platform. Includes CRM, E-Commerce store management, HR tools, company communications, and a configurable dashboard.",
    "changes": [
      {
        "category": "feature",
        "description": "CRM module with Customers, Vendors, Contacts, Opportunities, and Tasks"
      },
      {
        "category": "feature",
        "description": "CRM bulk import from Insightly CSV exports for contacts and opportunities"
      },
      {
        "category": "feature",
        "description": "Opportunity pipeline stage tracking with history"
      },
      {
        "category": "feature",
        "description": "CRM task management with priority, comments, attachments, and progress tracking"
      },
      {
        "category": "feature",
        "description": "CRM sales goals configuration and quick-fill via admin panel"
      },
      {
        "category": "feature",
        "description": "CRM tagging system for customers, vendors, and contacts"
      },
      {
        "category": "feature",
        "description": "Brand data enrichment via Brandfetch integration"
      },
      {
        "category": "feature",
        "description": "Artwork library per customer with Cloudinary upload and vectorization"
      },
      {
        "category": "feature",
        "description": "Online Stores with visual Gantt timeline and urgency status"
      },
      {
        "category": "feature",
        "description": "Store detail tabs: Overview, Team, CRM Links, Tasks, Add Tracking"
      },
      {
        "category": "feature",
        "description": "New Customer creation with direct push to Aturian (commissioned client, tax exempt, contact department)"
      },
      {
        "category": "feature",
        "description": "Employee Directory with profiles, bios, skills, and manager hierarchy"
      },
      {
        "category": "feature",
        "description": "Documents section with Google Drive integration"
      },
      {
        "category": "feature",
        "description": "News & Announcements with Tiptap rich-text editor, cover images, and article types"
      },
      {
        "category": "feature",
        "description": "Hero carousel banner with image upload and draft/publish workflow"
      },
      {
        "category": "feature",
        "description": "Scrolling ticker strip with birthdays, anniversaries, news, holidays, and ClickUp tasks"
      },
      {
        "category": "feature",
        "description": "Event countdown timer in the topbar"
      },
      {
        "category": "feature",
        "description": "Birthdays & Anniversaries page with upcoming events"
      },
      {
        "category": "feature",
        "description": "My Tasks dashboard card with live ClickUp integration per user"
      },
      {
        "category": "feature",
        "description": "Google Search and Gmail quick-access in the topbar"
      },
      {
        "category": "feature",
        "description": "Collapsible sidebar navigation with persistent section state"
      },
      {
